{
  "name": "WA Chem",
  "short_name": "WA Chem",
  "description": "WA Chem molecular editor",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "theme_color": "#2563eb",
  "background_color": "#f6f8fb",
  "icons": [
    {
      "src": "/app-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/app-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "/",
      "accept": {
        "application/vnd.fuluwa.wa-chem": [
          ".wachem"
        ],
        "application/json": [
          ".wachem"
        ]
      }
    }
  ]
}
